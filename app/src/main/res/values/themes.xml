<resources>
    <style name="Theme.VolumeButtonTweak" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="android:statusBarColor">@color/dark_bg</item>
        <item name="android:navigationBarColor">@color/dark_bg</item>
        <item name="android:windowBackground">@color/dark_bg</item>
    </style>

    <style name="Widget.VolumeTweak.PresetChip" parent="Widget.Material3.Button.TonalButton">
        <item name="android:textColor">#FFFFFF</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:singleLine">true</item>
        <item name="android:maxLines">1</item>
        <item name="android:ellipsize">none</item>
        <item name="android:minWidth">56dp</item>
        <item name="android:minHeight">36dp</item>
        <item name="backgroundTint">#222222</item>
        <item name="cornerRadius">10dp</item>
        <item name="strokeColor">#333333</item>
        <item name="strokeWidth">1dp</item>
    </style>
</resources>
