<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="#121212"
    android:padding="20dp">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <ImageView
            android:id="@+id/imgParamActionIcon"
            android:layout_width="24dp"
            android:layout_height="24dp"
            app:srcCompat="@drawable/ph_fast_forward"
            app:tint="#D71921" />

        <TextView
            android:id="@+id/tvParamDialogTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:text="CUSTOMIZE ACTION"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:textStyle="bold"
            android:letterSpacing="0.06" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvParamDialogSubtitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="Set the custom parameter value for this action."
        android:textColor="#888888"
        android:textSize="12sp" />

    <!-- Value Card -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:background="@drawable/bg_stat_box"
        android:padding="16dp"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvParamValueDisplay"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="15 seconds"
            android:textColor="#FFFFFF"
            android:textSize="24sp"
            android:textStyle="bold" />

        <!-- Slider -->
        <SeekBar
            android:id="@+id/seekParam"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:progressTint="#D71921"
            android:thumbTint="#FFFFFF" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="4dp">

            <TextView
                android:id="@+id/tvParamMin"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="5s"
                android:textColor="#555555"
                android:textSize="10.5sp" />

            <TextView
                android:id="@+id/tvParamMax"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="120s"
                android:textColor="#555555"
                android:textSize="10.5sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Quick Presets -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:text="QUICK PRESETS"
        android:textColor="#666666"
        android:textSize="10.5sp"
        android:textStyle="bold" />

    <LinearLayout
        android:id="@+id/containerParamChips"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:orientation="horizontal">
        <!-- Dynamically populated or preset buttons -->
    </LinearLayout>

    <!-- Action Buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnParamCancel"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:layout_marginEnd="8dp"
            android:text="Cancel"
            android:textColor="#AAAAAA"
            app:backgroundTint="#1F1F1F"
            app:cornerRadius="12dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnParamSave"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:text="Save Action"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            app:backgroundTint="#D71921"
            app:cornerRadius="12dp" />
    </LinearLayout>
</LinearLayout>
